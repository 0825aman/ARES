# ─── Application ─────────────────────────────────────────────────────────────
# Local development default:
DATABASE_URL=sqlite+aiosqlite:///./maar_dev.db
# Docker deployment default:
# DATABASE_URL=sqlite+aiosqlite:////app/data/maar.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
APP_ENV=development

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
# In Docker:
# UPLOAD_DIR=/app/uploads
# EXPORT_DIR=/app/exports
MAX_UPLOAD_SIZE_MB=20

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "gemini", "watsonx", "groq", "openrouter", or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=120

# ─── Fallback Providers (used when primary runs out of tokens or hits rate limits) ──
FALLBACK_LLM_PROVIDERS=groq,openrouter

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Groq Cloud ───────────────────────────────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ─── Web Search Provider ──────────────────────────────────────────────────────
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_tavily_api_key_here
SEARCH_MAX_RESULTS=8
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_CONTENT_KB=200

# ─── Research Workflow ────────────────────────────────────────────────────────
LLM_CONTEXT_BUDGET_CHARS=60000

# ─── Multi-Agent & LangGraph Settings ─────────────────────────────────────────
MAX_SUPERVISOR_CYCLES=3
CHECKPOINT_DB_URL=./maar_checkpoints.db
# In Docker:
# CHECKPOINT_DB_URL=/app/data/maar_checkpoints.db
LOG_FORMAT=text

# ─── Phase 4 Settings ─────────────────────────────────────────────────────────
ARXIV_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=
VERIFICATION_DEPTH=basic
MAX_CLAIMS_PER_RUN=20
CRITIC_MAX_REVIEW_CYCLES=2
ENABLE_LLM_USAGE_TRACKING=true
LLM_COST_PER_1K_TOKENS=0.0

# ─── Phase 6: Database Optimization ──────────────────────────────────────────
DB_WAL_MODE=true
DB_BUSY_TIMEOUT_MS=5000

# ─── Phase 6: Retry Configuration ─────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=1.0

# ─── Phase 6: Authentication & Security ──────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change_this_to_a_random_32_char_secret_in_production
SESSION_TTL_HOURS=8
# Set to true to bypass login requirement in local development
AUTO_LOGIN_DEV=false
ADMIN_USERNAME=admin
# Generate bcrypt hash: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
